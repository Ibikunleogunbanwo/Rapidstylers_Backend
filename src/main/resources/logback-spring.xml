<?xml version="1.0" encoding="UTF-8"?>
<!--
    Observability split (kept deliberately — see docs/simplification-plan.md §3):
      1. JSON_CONSOLE  — the log record (structured JSON on stdout; feeds docker logs
                         and the deploy checklist greps). Always on.
      2. BETTERSTACK   — optional log transport to Better Stack over HTTP. Off unless
                         LOG_TOKEN is set; shipping failures only warn.
      3. Sentry (spring-boot-starter, no config here) — error tracking, off unless
                         SENTRY_DSN is set.
    There is exactly one shipping path and one error tracker; do not add a second.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Structured JSON to stdout — parseable in Docker/Vercel and any log sink. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- Optional Better Stack (logtail) HTTP sink — active only when LOG_TOKEN is set. -->
    <springProperty scope="context" name="logToken" source="LOG_TOKEN" defaultValue=""/>
    <springProperty scope="context" name="logEndpoint" source="LOG_ENDPOINT" defaultValue="https://in.logs.betterstack.com"/>
    <appender name="BETTERSTACK" class="com.macrotel.rapidstylers.config.BetterStackLogbackAppender">
        <token>${logToken}</token>
        <endpoint>${logEndpoint}</endpoint>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
        <appender-ref ref="BETTERSTACK"/>
    </root>

    <logger name="com.macrotel.rapidstylers" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
</configuration>
