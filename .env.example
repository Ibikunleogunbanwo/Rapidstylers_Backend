# RapidStylers Backend — copy to .env and fill in real values
# .env is gitignored; never commit real secrets.
#
# ── STARTUP-CRITICAL VALUES ────────────────────────────────────────────────
# Getting one of these wrong takes the API down, so they are audited here.
#
# Fails to BOOT when unset (no default exists anywhere):
#   DB_PASSWORD      spring.datasource.password=${DB_PASSWORD}
#   APP_API_KEY      app.api.key=${APP_API_KEY}             (@Value has no default)
#   RESEND_API_KEY   app.resend.api-key=${RESEND_API_KEY}   (@Value has no default)
#
# Fails to BOOT when unset, empty or published (explicit start-up guard):
#   ENCRYPT_KEY      EncryptionConfig refuses the repo's public fallback key.
#                    The "test" profile is exempt because the suite pins that key.
#   JWT_SECRET       JwtUtil refuses an empty key, the placeholder shipped below,
#                    and anything shorter than 256 bits (the HS256 minimum).
#                    No profile is exempt — the suite uses a real 48-byte default,
#                    so nothing ever legitimately needs a weak signing key.
#
# Boots fine, then breaks in production use — the dangerous category, because the
# deploy health gate passes and /actuator/health still reports UP:
#   ADMIN_PASSWORD   a known-weak value is skipped, so no admin is ever seeded
#
# A fourth category, and the reason it is called out here: a control that is simply
# OFF when unset, without saying so. TURNSTILE_SECRET_KEY is one — the app boots,
# sign-in works, and nothing anywhere reports that the challenge is disabled. It is
# warned about loudly at start-up and by the deploy pre-flight, deliberately instead
# of failing the boot, because refusing to start over an optional control is the
# ENCRYPT_KEY outage over again.
#
# NOTE — production receives ONLY what docker-compose.prod.yml forwards. That file
# has no `env_file:`, so a variable absent from its `environment:` block cannot take
# effect on the VPS at all. Every variable the app reads is now in one of two states,
# and EnvForwardingContractTest fails the build if a new one is in neither:
#
#   * forwarded as `VAR: ${VAR:-default}` — this file wins, and the default equals
#     the app's own, so leaving it out changes nothing;
#   * a container-network literal — .env cannot override it. That is deliberate for
#     DB_URL, REDIS_HOST, REDIS_PORT and KAFKA_BOOTSTRAP_SERVERS, because inside the
#     compose network those must be the service names, while the values a few lines
#     below are `localhost` for local runs. Honouring them in a container would point
#     it at itself. Set the matching values in your local .env, not the VPS one.
#
# The deploy pre-flight (scripts/check-required-env.sh) additionally never lets a
# startup-critical value go missing: it is handed this repo's compose file and fails
# the deploy in seconds if one is present in .env but not forwarded, which would
# otherwise reach production as a silent no-op and crash-loop the container.

DB_URL=jdbc:mysql://localhost:3306/rapid_stylers
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Must match REACT_APP_API_KEY in RapidStyler_frontend/.env
APP_API_KEY=your_api_key

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=onboarding@resend.dev

# Stripe (RapidStylers account only; never use AfroChow credentials)
# Stripe mode switch: "test" or "live". Empty keeps legacy single-key behavior.
STRIPE_MODE=test
# Legacy single key set (used only when STRIPE_MODE is empty).
STRIPE_SECRET_KEY=sk_test_or_sk_live_your_rapidstylers_key
STRIPE_WEBHOOK_SECRET=whsec_platform_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connected_accounts_webhook_secret
# Test-mode key set (active when STRIPE_MODE=test).
STRIPE_TEST_SECRET_KEY=sk_test_your_key
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_platform_webhook_secret
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=whsec_test_connected_accounts_webhook_secret
# Live-mode key set (active when STRIPE_MODE=live).
STRIPE_LIVE_SECRET_KEY=sk_live_your_key
STRIPE_LIVE_WEBHOOK_SECRET=whsec_live_platform_webhook_secret
STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=whsec_live_connected_accounts_webhook_secret
STRIPE_CURRENCY=cad
STRIPE_COMMISSION_PERCENT=12

# Cloudinary — https://console.cloudinary.com (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Upload constraints, enforced by Cloudinary because they are part of the signature
# the backend issues: a client cannot drop or widen them. Leaving both blank uses
# the defaults below (images only, 5 MB).
CLOUDINARY_ALLOWED_FORMATS=jpg,jpeg,png,webp,gif
CLOUDINARY_MAX_FILE_SIZE_BYTES=5242880

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile → Add site.
# Set BOTH this and REACT_APP_TURNSTILE_SITE_KEY in RapidStyler_frontend/.env, or
# NEITHER: an empty secret here means the backend stops requiring a challenge,
# so setting only the site key renders a widget that is never checked.
# Hostnames are configured in the Cloudflare dashboard, not here. Leaving it empty
# disables bot protection on the sign-in endpoints (warned about at start-up).
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Demo seed — APP_DEMO_SEED=true makes boot create one approved demo stylist per
# service type so public search is never all-empty on a fresh or wiped database.
# Rows are inert (unmatchable password, no contact details) and real stylists are
# never touched. Default false.
APP_DEMO_SEED=false
# Admin bootstrap — ADMIN_EMAIL/ADMIN_PASSWORD seed the first admin_accounts DB
# row on first boot (BCrypt) only when the table is empty. Admin sign-in checks
# admin_accounts; more admins and password changes are at POST /rapid_stylers/admin/accounts.
# The bootstrap password MUST be strong: known defaults/weak values (e.g. "change_me") are
# rejected by AdminAccountInitializer on boot, and the admin account API rejects them too.
# IMPORTANT: keep it alphanumeric (plus - _ .). Docker Compose interpolates $ and treats some
# chars like ! specially when it passes ${ADMIN_PASSWORD} into the container, so a password
# containing $ or ! gets silently mangled on deploy — avoid both characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_strong_unique_passphrase_here

# Sentry error monitoring — leave empty to disable. From Sentry → Settings → Keys.
SENTRY_DSN=
APP_ENV=local

# JWT (role-based auth) — run: openssl rand -hex 64
# Access-token TTL in minutes. NFR requires 15 (short-lived). Keep this at 15 —
# the app defaults to 15 anyway, so a stale copy here silently lengthens tokens.
#
# REQUIRED. JwtUtil validates this at start-up and refuses to boot on any of:
#   * empty or whitespace — every login would fail while /actuator/health still
#     reported UP, so the deploy would look successful;
#   * the placeholder below — that string is in public source, so anyone with the
#     repository could mint admin tokens;
#   * under 256 bits (32 bytes) — HS256's minimum, which the JVM rejects when
#     signing.
# Failing at boot is the point: a bad value stops the deploy instead of surfacing
# as rejected logins after it has already replaced the live container.
JWT_SECRET=run_openssl_rand_-hex_64
JWT_TTL_MINUTES=15

# Encryption key for card-details user IDs. REQUIRED everywhere except tests —
# generate a real value:  openssl rand -hex 32
#
# EncryptionConfig refuses to start outside the "test" profile when this is
# empty or unset, because the only fallback is a key published in this repo
# (AppConstants.ENCRYPT_DECRYPT_KEY_FALLBACK). A blank value here is therefore
# NOT a safe default in production — it is a boot failure, by design.
#
# Generating a fresh key is safe: no live flow encrypts or decrypts card data
# (card user-ids are stored plaintext). Only the admin-only POST /decrypt tool
# reads ciphertext, so a new key makes previously encrypted values unreadable
# there and nothing anywhere else.
#
# Keep this out of the repo and out of CI logs — environment only. There is no
# second copy, so store it somewhere durable (password manager) and keep it
# identical across any environment that must read the same ciphertext.
ENCRYPT_KEY=

# Google Maps — Places/geocoding proxy (server-side key)
GOOGLE_API_KEY=your_google_key

# Google Sign-In OAuth Client ID (Web application). Public, safe to ship.
GOOGLE_CLIENT_ID=your_google_client_id

# Rate-limit trusted proxies: only these peers' X-Forwarded-For is honored so
# per-IP buckets key by the real client. Behind Cloudflare + Nginx + Docker:
# loopback, the Docker bridge gateway (docker-proxy forwards 127.0.0.1:9095
# into the container, so Nginx appears to the app as the bridge peer), and
# Cloudflare's published ranges. See docker-compose.prod.yml for the default.
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32,172.18.0.1/32

# Read-cache warm-up (issue #4): a bounded, non-blocking background warm-up of
# the most-requested catalog + approved-stylist DTO keys runs on every cold
# start (deploy / Redis flush). warm-enabled can be flipped to false to disable;
# warm-max-stylers caps how many approved profiles are pre-warmed (newest first).
CACHE_WARM_ENABLED=true
CACHE_WARM_MAX_STYLERS=25

# Server-side idle timeout (minutes) per role, enforced on /auth/refresh via
# Redis last-activity. Once an account has been idle past its window, a refresh
# is refused and its whole refresh-token family is revoked across tabs/devices.
SESSION_IDLE_CUSTOMER_MINUTES=60
SESSION_IDLE_STYLER_MINUTES=30
SESSION_IDLE_ADMIN_MINUTES=30
# Absolute lifetime (hours) for an admin session: force re-login after this time,
# even if the admin has been actively using the app (idle timeout alone isn't enough).
SESSION_ABSOLUTE_ADMIN_HOURS=8

# Redis - host port 6380 avoids AfroChow's Redis on 6379
REDIS_HOST=localhost
# Local dev Redis binds 6379; prod compose overrides to service name 'redis'.
REDIS_PORT=6379
REDIS_HOST_PORT=6379
# Set when the local/redis service requires auth (e.g. afrochow-redis).
# leave blank when the Redis server has no password (prod compose default).
REDIS_PASSWORD=

# Kafka
# Local Spring Boot process: localhost:9094
# Spring Boot in Docker on the VPS: kafka:19094
# Set KAFKA_BOOTSTRAP_SERVERS=kafka:19094 in the VPS .env.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_HOST_PORT=9094
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost
KAFKA_UI_HOST_PORT=8089
KAFKA_TOPIC_DOMAIN_EVENTS=rapidstylers.domain-events
KAFKA_TOPIC_DOMAIN_EVENTS_RETRY=rapidstylers.domain-events.retry
KAFKA_TOPIC_DOMAIN_EVENTS_DLQ=rapidstylers.domain-events.dlq
KAFKA_OUTBOX_PUBLISHER_ENABLED=true
KAFKA_OUTBOX_PUBLISHER_DELAY_MS=5000
KAFKA_OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_OUTBOX_RETRY_DELAY_SECONDS=30
KAFKA_OUTBOX_MAX_ATTEMPTS=3
KAFKA_NOTIFICATIONS_CONSUMER_ENABLED=true
KAFKA_NOTIFICATIONS_GROUP_ID=rapidstylers-notification-service

# ── Forwarded by docker-compose.prod.yml but previously undocumented here ──
# All optional; leaving them blank keeps the app's built-in defaults.

# Ops alert recipient for payment disputes / reconciliation findings.
APP_ADMIN_ALERT_EMAIL=

# Structured log shipping (Better Stack). Blank keeps console JSON only.
LOG_TOKEN=
LOG_ENDPOINT=https://in.logs.betterstack.com

# Consumer idempotency: hours a delivered notification event is remembered.
NOTIFICATION_DEDUP_TTL_HOURS=24

# Payout recovery: retry interval (ms) and attempt budget for transfer reversals.
PAYOUT_REVERSAL_RETRY_INTERVAL_MS=1800000
PAYOUT_REVERSAL_MAX_ATTEMPTS=5

# Stylists may cancel a completed booking within this window (hours).
STYLER_CANCEL_WINDOW_HOURS=24

# ── Forwarded, but with non-empty built-in defaults ───────────────────────
# These are COMMENTED DELIBERATELY. An empty value here is not the same as
# omitting the line: compose's `:-` substitutes on empty, but Spring's local
# `spring.config.import` of this file does not, so a bare `VAR=` would really set
# an empty property (an empty CORS allowlist, for instance). Uncomment to override.

# Timezone used for booking and slot calculations.
# APP_TIME_ZONE=America/Edmonton

# Browser origins allowed to call the API (comma-separated, exact match).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:9090,https://rapidstylers.ca,https://www.rapidstylers.ca

# Cloudinary folder prefixes a portfolio upload may use.
# CLOUDINARY_ALLOWED_FOLDER_PREFIXES=profile,id,store,portfolio

# Upload format/size ceilings (signed, so Cloudinary enforces them).
# CLOUDINARY_ALLOWED_FORMATS=jpg,jpeg,png,webp,gif
# CLOUDINARY_MAX_FILE_SIZE_BYTES=5242880

# Local upload directory, used only when Cloudinary is not configured.
# FILE_UPLOAD_DIR=uploads/rapidstyler

# Fraction of requests traced by Sentry (0.0 = errors only).
# SENTRY_TRACES_SAMPLE_RATE=0.0

# How long a booking authorization may be held before capture (hours), and how far
# ahead a booking may be authorized (days).
# BOOKING_PAYMENT_AUTHORIZATION_LEAD_HOURS=48
# BOOKING_PAYMENT_AUTHORIZATION_WINDOW_DAYS=7

# ── ⚠ Changing this one is not like changing the others ───────────────────
# KAFKA_NOTIFICATIONS_GROUP_ID above is now forwarded, so .env controls it. A new
# group makes Kafka start from its own offsets, so events are replayed or skipped
# and a recipient can be notified twice for anything older than
# NOTIFICATION_DEDUP_TTL_HOURS. The deploy pre-flight warns when the VPS value
# differs from the default above, so the change is never silent.
