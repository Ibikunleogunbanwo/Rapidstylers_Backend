# RapidStylers Backend — copy to .env and fill in real values
# .env is gitignored; never commit real secrets.

DB_URL=jdbc:mysql://localhost:3306/rapid_stylers
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Must match REACT_APP_API_KEY in RapidStyler_frontend/.env
APP_API_KEY=your_api_key

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=onboarding@resend.dev

# Cloudinary — https://console.cloudinary.com (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin access — only these credentials get an ADMIN-role JWT
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# JWT (role-based auth) — run: openssl rand -hex 64
JWT_SECRET=run_openssl_rand_-hex_64
JWT_TTL_MINUTES=120

# Google Maps — Places/geocoding proxy (server-side key)
GOOGLE_API_KEY=your_google_key

# Pexels image gallery proxy (free tier: 200 req/hr; cached 1 hr server-side)
# https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key

# Redis - host port 6380 avoids AfroChow's Redis on 6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_PORT=6380

# Kafka
# Local Spring Boot process: localhost:9094
# Spring Boot in Docker on the VPS: kafka:19094
# Set KAFKA_BOOTSTRAP_SERVERS=kafka:19094 in the VPS .env.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_HOST_PORT=9094
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost
KAFKA_UI_HOST_PORT=8089
KAFKA_TOPIC_DOMAIN_EVENTS=rapidstylers.domain-events
KAFKA_TOPIC_DOMAIN_EVENTS_RETRY=rapidstylers.domain-events.retry
KAFKA_TOPIC_DOMAIN_EVENTS_DLQ=rapidstylers.domain-events.dlq
KAFKA_OUTBOX_PUBLISHER_ENABLED=true
KAFKA_OUTBOX_PUBLISHER_DELAY_MS=5000
KAFKA_OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_OUTBOX_RETRY_DELAY_SECONDS=30
KAFKA_OUTBOX_MAX_ATTEMPTS=3
KAFKA_NOTIFICATIONS_CONSUMER_ENABLED=true
KAFKA_NOTIFICATIONS_GROUP_ID=rapidstylers-notification-service
